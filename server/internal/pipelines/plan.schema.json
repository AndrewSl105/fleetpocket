{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleetpocket/pipelines/plan.schema.json",
  "title": "Pipeline plan (plan.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "subtasks"],
  "properties": {
    "summary": { "type": "string", "minLength": 1 },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "description"],
        "properties": { "path": { "type": "string", "minLength": 1 }, "description": { "type": "string" } }
      }
    },
    "subtasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "title", "prompt", "provider", "files", "depends_on", "done_when"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
          "title": { "type": "string", "minLength": 1 },
          "prompt": { "type": "string", "minLength": 1 },
          "provider": { "enum": ["claude", "codex", "cursor"] },
          "files": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "depends_on": { "type": "array", "items": { "type": "string" } },
          "done_when": { "type": "string", "minLength": 1 }
        }
      }
    },
    "risks": { "type": "array", "items": { "type": "string" } }
  }
}
